    {
      "parameters": {
        "jsCode": "const link = $json[\"Upload Resume / CV\"] || $json.body?.[\"Upload Resume / CV\"] || \"\";\n\nlet fileId = null;\n\nconst match = link.match(/[-\\w]{25,}/);\n\nif (match) {\n  fileId = match[0];\n}\n\nreturn [{\n  json: {\n    ...$json,   // keep EVERYTHING exactly the same\n    fileId\n  }\n}];"
      },
