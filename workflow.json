        "jsCode": "const strengths = $json.ai_strengths || [];\nconst weaknesses = $json.ai_weaknesses || [];\n\nconst strengthBlocks = strengths.map(s => ({\n  type: \"bulleted_list_item\",\n  bulleted_list_item: {\n    rich_text: [\n      {\n        type: \"text\",\n        text: { content: s }\n      }\n    ]\n  }\n}));\n\nconst weaknessBlocks = weaknesses.map(w => ({\n  type: \"bulleted_list_item\",\n  bulleted_list_item: {\n    rich_text: [\n      {\n        type: \"text\",\n        text: { content: w }\n      }\n    ]\n  }\n}));\n\nreturn [{\n  json: {\n    ...$json,\n    strength_blocks: strengthBlocks,\n    weakness_blocks: weaknessBlocks\n  }\n}];"
