      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const original = $items(\"Download file\")[0].json;\nconst resume = $json.resume_text;\n\nreturn [\n{\njson: {\n...original,\nresume_text: resume\n}\n}\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -192,
        160
      ],
      "id": "f41956b3-085b-4097-af83-b0ceece3e749",
      "name": "Clean Resume Text"
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\nconst answers = Object.entries(data.form_data || {})\n  .filter(([k,v]) => v && v !== \"\")\n  .map(([k,v]) => `${k}: ${v}`)\n  .join(\"\\n\");\n\nconst resume = (data.resume_text || \"\")\n  .replace(/\\(cid:\\d+\\)/g,\"\")\n  .replace(/\\s+/g,\" \")\n  .trim();\n\nconst profile = `\nCANDIDATE INFORMATION\nName: ${data.candidate_name ?? \"\"}\nCity: ${data.city ?? \"\"}\nRole Applied: ${data.role ?? \"\"}\n\nRESUME CONTENT\n${resume}\n\nCANDIDATE ANSWERS\n${answers}\n`;\n\nreturn [{\n  json: {\n    ...data,\n    candidate_profile: profile\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -672,
        400
      ],
      "id": "63f390de-fa96-4051-9b8d-0f2a3aa012e0",
      "name": "Build Candidate Context"
    },
    {
      "parameters": {
        "jsCode": "const prompt = `\nYou are an AI recruitment assistant.\n\nAnalyze this candidate and return ONLY valid JSON.\n\nDO NOT write explanations.\nDO NOT write text.\nRETURN JSON ONLY.\n\nRequired format:\n\n{\n \"score\": number from 0-100,\n \"strengths\": [\"strength1\",\"strength2\"],\n \"weaknesses\": [\"weakness1\",\"weakness2\"],\n \"recommendation\": \"Reject | Review | Interview\"\n}\n\nCandidate profile:\n\n${$json.candidate_profile}\n`;\n\nreturn [{\n  json: {\n    contents: [\n      {\n        parts: [\n          { text: prompt }\n        ]\n      }\n    ]\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        400
      ],
      "id": "da96cead-5b20-411a-b505-4472607ca738",
      "name": "Prepare Gemini Prompt"
    },
    {
      "parameters": {
        "jsCode": "let raw;\n\nif ($json.candidates && $json.candidates[0]?.content?.parts?.[0]?.text) {\n  raw = $json.candidates[0].content.parts[0].text;\n}\n\nlet result;\n\ntry {\n\n  if (raw) {\n    raw = raw.replace(/```json|```/g, '').trim();\n  }\n\n  result = raw ? JSON.parse(raw) : null;\n\n} catch {\n  result = null;\n}\n\nif (!result) {\n  result = {\n    score: 0,\n    strengths: [\"AI evaluation unavailable\"],\n    weaknesses: [\"AI evaluation unavailable\"],\n    recommendation: \"Review\"\n  };\n}\n\nreturn [\n  {\n    json: {\n      ai_score: result.score,\n      ai_strengths: result.strengths,\n      ai_weaknesses: result.weaknesses,\n      ai_recommendation: result.recommendation\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        64,
        400
      ],
