      "name": "Append Job Questions",
      "credentials": {
        "notionApi": {
          "id": "YOUR_NOTION_CREDENTIAL_ID",
          "name": "Notion account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $node[\"Normalize Form Data\"].json.form_data;\n\n// Fields that should NEVER appear in Role Questions\nconst excludedFields = [\n\"Timestamp\",\n\"Full Name\",\n\"Email\",\n\"WhatsApp Number\",\n\"City\",\n\"Upload Resume / CV\",\n\"How did you hear about this job?\",\n\"What type of position are you applying for?\",\n\"Confirm the role you are applying for\",\n\"When can you start if selected?\",\n\"Are you comfortable committing to at least 1 year with the company?\",\n\"Minimum monthly salary expectancy\",\n\"Maximum monthly salary expectancy\",\n\"Are you currently a student or a recent graduate?\",\n\"Are you available to work from our office on a daily basis?\",\n\"Are you willing to commit to a minimum 3 month internship?\"\n];\n\nlet answers = [];\nlet additionalNotes = \"\";\n\n// URL detection\nconst urlRegex = /(https?:\\/\\/[^\\s]+)/g;\n\nObject.keys(data).forEach(key => {\n\n  if (\n    !excludedFields.includes(key) &&\n    data[key] !== \"\" &&\n    data[key] !== null &&\n    data[key] !== undefined &&\n    typeof data[key] !== \"object\"\n  ) {\n\n    let value = data[key].toString().trim();\n\n    // Normalize paragraph spacing\n    value = value\n      .replace(/\\r?\\n+/g, \" \")   // remove line breaks\n      .replace(/\\s+/g, \" \")      // collapse multiple spaces\n      .trim();\n\n    // Format links on separate lines\n    if (urlRegex.test(value)) {\n      value = value.replace(urlRegex, \"\\n$1\");\n    }\n\n    if (key.toLowerCase().includes(\"anything else\")) {\n\n      additionalNotes = `\\n\\n• Additional Notes\\n${value}`;\n\n    } else {\n\n      answers.push(`• ${key}\\n${value}`);\n\n    }\n\n  }\n\n});\n\nconst roleText = answers.join(\"\\n\\n\") + additionalNotes;\n\n\n// SAFE SPLITTING FOR NOTION\nconst MAX = 1800;\nconst blocks = roleText.split(\"\\n\\n• \").map((b, i) => i === 0 ? b : \"• \" + b);\n\nlet chunks = [];\nlet current = \"\";\n\nfor (const block of blocks) {\n\n  if ((current + \"\\n\\n\" + block).length > MAX) {\n    chunks.push(current.trim());\n    current = block;\n  } else {\n    current += \"\\n\\n\" + block;\n  }\n\n}\n\nif (current) {\n  chunks.push(current.trim());\n}\n\nreturn chunks.map(chunk => ({\n  json: {\n    chunk\n  }\n}));"
      },
