      "parameters": {
        "jsCode": "const output = [];\n\nconst possibleFields = [\n  'Upload Resume / CV',\n  'Portfolio Work',\n];\n\nconst driveIdRegex = /(?:id=|\\/d\\/)([a-zA-Z0-9_-]{20,})/;\n\nfor (const item of $input.all()) {\n\n  const row = item.json.body;\n\n  for (const field of possibleFields) {\n\n    const value = row[field];\n    if (!value) continue;\n\n    const links = value.split(/\\s+/);\n\n    for (const link of links) {\n\n      const match = link.match(driveIdRegex);\n\n      if (match && match[1]) {\n        output.push({\n          json: {\n            fileId: match[1],\n            sourceField: field,\n            originalLink: link\n          }\n        });\n      }\n\n    }\n  }\n}\n\nif (output.length === 0) {\n  return [{ json: { skip: true } }];\n}\n\nreturn output;"
      },
